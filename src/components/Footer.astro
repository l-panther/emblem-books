---
import { page } from '../utils/paths';
import { COMPANY_EMAIL, COMPANY_NAME, COMPANY_TELEPHONE } from '../lib/config';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand-name">{COMPANY_NAME}</span>
        <p>Rare, first-edition, and collectible books — restored, valued, and shipped worldwide from London.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/books/">Books</a>
        <a href="/delivery/">Delivery</a>
        <a href="/about/">About Us</a>
        <a href="/investment/">Books as Investment</a>
      </div>
      <div>
        <h4>More Links</h4>
        <a href="/terms/">Terms of use</a>
        <a href="/privacy/">Privacy &amp; Cookies</a>
        <a href={page('contact/')}>Contact us</a>
      </div>
      <div>
        <h4>Call us</h4>
        <a href="tel:02071235555">{COMPANY_TELEPHONE}</a>
        <a href="mailto:enquiries@emblembooks.co.uk">{COMPANY_EMAIL}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {COMPANY_NAME}. All rights reserved.</span>
      <div class="social-row">
        <a href="#" aria-label="Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H16.7V3.7c-.28-.04-1.25-.12-2.37-.12-2.35 0-3.96 1.43-3.96 4.06V10H7.6v3.1h2.77V21h3.13Z"/></svg>
        </a>
        <a href="#" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="mailto:enquiries@emblembooks.co.uk" aria-label="Email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>


<style>

/* ---------- footer ---------- */
.site-footer {
  background: var(--ink);
  color: rgba(247,242,230,0.75);
  padding: 64px 0 32px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(247,242,230,0.14);
}
.footer-grid h4 {
  color: var(--paper);
  font-family: var(--font-sans);
  font-size: 13px;
  letter-spacing: .07em;
  text-transform: uppercase;
  margin-bottom: 18px;
}
.footer-grid a {
  display: block;
  text-decoration: none;
  color: rgba(247,242,230,0.7);
  font-family: var(--font-sans);
  font-size: 14px;
  margin-bottom: 12px;
}
.footer-grid a:hover { color: var(--gold-soft); }
.footer-brand .brand-name { color: var(--paper); }
.footer-brand p { color: rgba(247,242,230,0.6); font-family: var(--font-sans); font-size: 13.5px; max-width: 32ch; margin-top: 14px; }
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 28px;
  font-family: var(--font-sans);
  font-size: 13px;
  flex-wrap: wrap;
  gap: 16px;
}
.social-row { display: flex; gap: 12px; }
.social-row a {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(247,242,230,0.25);
  display: flex; align-items: center; justify-content: center;
  text-decoration: none;
  color: rgba(247,242,230,0.8);
}
.social-row a:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }

@media (max-width: 980px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 560px) {
  .footer-grid { grid-template-columns: 1fr; }
}
</style>
