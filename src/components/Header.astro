---
const { active = '' } = Astro.props;

// GitHub Pages base path from astro.config
const base = import.meta.env.BASE_URL;

const navItems = [
  { id: 'home', label: 'Home', href: base },
  { id: 'books', label: 'Books', href: `${base}books/` },
];

const tailItems = [
  { id: 'delivery', label: 'Delivery', href: `${base}delivery/` },
  { id: 'about', label: 'About Us', href: `${base}about/` },
  { id: 'investment', label: 'Books as Investment', href: `${base}investment/` },
];
---

<header class="site-header">

  <!-- Taglet: full logo + tagline, desktop only -->
  <div class="wrap taglet">
    <a class="brand" href={base}>
      <svg
        class="brand-mark"
        viewBox="0 0 64 64"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="32"
          cy="32"
          r="26"
          stroke="#1F5C3F"
          stroke-width="2.5"
        />

        <circle
          cx="32"
          cy="32"
          r="20"
          stroke="#1F5C3F"
          stroke-width="1"
        />

        <path
          d="M32 22c-3.5-2.4-8-3-12-1.6v18c4-1.4 8.5-.8 12 1.6 3.5-2.4 8-3 12-1.6v-18c-4-1.4-8.5-.8-12 1.6Z"
          fill="#1F5C3F"
        />

        <path
          d="M32 22v20"
          stroke="#F7F2E6"
          stroke-width="1"
        />
      </svg>

      <span>
        <span class="brand-name">Emblem Books</span>
        <span class="brand-tag">
          A collection of old and rare collectible books
        </span>
      </span>
    </a>
  </div>


  <!-- Toolbar -->
  <div class="wrap toolbar-row">

    <!-- Compact/mobile logo -->
    <a class="brand brand-compact" href={base}>
      <svg
        class="brand-mark"
        viewBox="0 0 64 64"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="32"
          cy="32"
          r="26"
          stroke="#1F5C3F"
          stroke-width="2.5"
        />

        <circle
          cx="32"
          cy="32"
          r="20"
          stroke="#1F5C3F"
          stroke-width="1"
        />

        <path
          d="M32 22c-3.5-2.4-8-3-12-1.6v18c4-1.4 8.5-.8 12 1.6 3.5-2.4 8-3 12-1.6v-18c-4-1.4-8.5-.8-12 1.6Z"
          fill="#1F5C3F"
        />

        <path
          d="M32 22v20"
          stroke="#F7F2E6"
          stroke-width="1"
        />
      </svg>

      <span class="brand-name">Emblem Books</span>
    </a>


    <!-- Mobile menu button -->
    <button
      class="menu-toggle"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#siteNav"
      aria-controls="siteNav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      Menu
    </button>


    <!-- Navigation -->
    <div
      class="offcanvas offcanvas-end"
      tabindex="-1"
      id="siteNav"
      aria-labelledby="siteNavLabel"
    >
      <div class="offcanvas-header">

        <span
          class="offcanvas-title brand-name"
          id="siteNavLabel"
        >
          Menu
        </span>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          data-bs-target="#siteNav"
          aria-label="Close menu"
        ></button>

      </div>

      <div class="offcanvas-body">

        <nav class="nav" aria-label="Primary">

          {navItems.map((item) => (
            <a
              href={item.href}
              class={active === item.id ? 'is-active' : ''}
              aria-current={active === item.id ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}

          {tailItems.map((item) => (
            <a
              href={item.href}
              class={active === item.id ? 'is-active' : ''}
              aria-current={active === item.id ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}

        </nav>

      </div>
    </div>

  </div>
</header>
