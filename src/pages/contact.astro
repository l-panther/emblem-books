---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us" active="contact">
  <section class="page-banner">
    <div class="wrap">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact Us</h1>
      <p>Please feel free to get in touch if you are looking to buy a book not listed in the collection, sell a book, request a valuation, or enquire about book repair.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0;">
    <div class="wrap contact-grid">
      <div>
        <div class="contact-line">
          <span class="icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5c0-.5.4-1 1-1h3l2 5-2 1.5a11 11 0 0 0 5.5 5.5L15 15l5 2v3c0 .5-.5 1-1 1C10 21 4 15 4 5Z"/></svg>
          </span>
          <div>
            <div style="font-weight:600;">Sales &amp; enquiries</div>
            <a href="tel:02071235555">0207 123 5555</a>
          </div>
        </div>
        <div class="contact-line">
          <span class="icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5c0-.5.4-1 1-1h3l2 5-2 1.5a11 11 0 0 0 5.5 5.5L15 15l5 2v3c0 .5-.5 1-1 1C10 21 4 15 4 5Z"/></svg>
          </span>
          <div>
            <div style="font-weight:600;">Valuations &amp; repairs</div>
            <a href="tel:02071235555">0207 123 5555</a>
          </div>
        </div>
        <div class="contact-line" style="border-bottom:none;">
          <span class="icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/></svg>
          </span>
          <div>
            <div style="font-weight:600;">Email</div>
            <a href="mailto:enquiries@emblembooks.co.uk">enquiries@emblembooks.co.uk</a>
          </div>
        </div>
      </div>

      <form class="contact-form" id="contactForm" novalidate aria-describedby="formStatus">
        <!-- Success alert panel, shown above the form fields -->
        <div id="formAlert" class="form-alert" role="alert" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
          </svg>
          <span id="formAlertText"></span>
          <button type="button" id="formAlertClose" aria-label="Dismiss">&times;</button>
        </div>

        <div class="field">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="you@example.com"
            required
            aria-required="true"
            aria-describedby="email-error"
          />
          <p id="email-error" class="field-error" role="alert"></p>
        </div>

        <div class="field">
          <label for="nature">Nature of enquiry</label>
          <select id="nature" name="nature" aria-describedby="nature-error">
            <option>Buying a book</option>
            <option>Selling a book</option>
            <option>Request a valuation</option>
            <option>Book repair / restoration</option>
            <option>Other</option>
          </select>
          <p id="nature-error" class="field-error" role="alert"></p>
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            maxlength="200"
            placeholder="Type your message here..."
            required
            aria-required="true"
            aria-describedby="message-error charCount-wrap"
          ></textarea>
          <div class="message-meta-row">
            <p id="message-error" class="field-error" role="alert"></p>
            <div class="char-count" id="charCount-wrap"><span id="charCount">0</span>/200</div>
          </div>
        </div>

        <button class="btn btn-primary" type="submit">
          <span class="btn-label">Send message</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>

        <p id="formStatus" class="visually-hidden" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  const textarea = document.getElementById('message') as HTMLTextAreaElement | null;
  const count = document.getElementById('charCount');
  textarea?.addEventListener('input', () => {
    if (count) count.textContent = String(textarea.value.length);
  });

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const formStatus = document.getElementById('formStatus');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  const alertPanel = document.getElementById('formAlert');
  const alertText = document.getElementById('formAlertText');
  const alertClose = document.getElementById('formAlertClose');

  type FieldName = 'email' | 'nature' | 'message';

  const fields: Record<FieldName, HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null> = {
    email: document.getElementById('email') as HTMLInputElement | null,
    nature: document.getElementById('nature') as HTMLSelectElement | null,
    message: document.getElementById('message') as HTMLTextAreaElement | null,
  };

  const validators: Record<FieldName, (value: string) => string> = {
    email(value: string) {
      const v = value.trim();
      if (!v) return 'Please enter your email address.';
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
      if (!emailPattern.test(v)) return 'Please enter a valid email address.';
      return '';
    },
    nature(value: string) {
      const v = value.trim();
      if (!v) return 'Please select the nature of your enquiry.';
      return '';
    },
    message(value: string) {
      const v = value.trim();
      if (!v) return 'Please enter a message.';
      if (v.length < 10) return 'Message should be at least 10 characters.';
      if (v.length > 200) return 'Message cannot exceed 200 characters.';
      return '';
    },
  };

  function setFieldError(name: FieldName, message: string) {
    const input = fields[name];
    const errorEl = document.getElementById(`${name}-error`);
    if (!input || !errorEl) return;

    if (message) {
      input.classList.add('is-invalid');
      input.classList.remove('is-valid');
      input.setAttribute('aria-invalid', 'true');
      errorEl.textContent = message;
    } else {
      input.classList.remove('is-invalid');
      input.classList.add('is-valid');
      input.setAttribute('aria-invalid', 'false');
      errorEl.textContent = '';
    }
  }

  function validateField(name: FieldName): boolean {
    const input = fields[name];
    if (!input) return true;
    const error = validators[name](input.value);
    setFieldError(name, error);
    return !error;
  }

  const fieldNames = Object.keys(fields) as FieldName[];

  fieldNames.forEach((name) => {
    const input = fields[name];
    input?.addEventListener('blur', () => validateField(name));
    input?.addEventListener('input', () => {
      if (input.classList.contains('is-invalid')) validateField(name);
    });
    if (input instanceof HTMLSelectElement) {
      input.addEventListener('change', () => validateField(name));
    }
  });

  function validateAll(): boolean {
    let isValid = true;

    fieldNames.forEach((name) => {
      if (!validateField(name)) isValid = false;
    });

    if (!isValid) {
      const firstInvalidName = fieldNames.find((name) => {
        const input = fields[name];
        return input?.classList.contains('is-invalid');
      });
      if (firstInvalidName) fields[firstInvalidName]?.focus();
    }

    return isValid;
  }

  // Simulates a server-side round trip (fake site — no real endpoint).
  function fakeServerSubmit(formData: Record<string, string>): Promise<{ ok: boolean }> {
    return new Promise((resolve) => {
      setTimeout(() => resolve({ ok: true }), 800);
    });
  }

  function showAlert(message: string, tone: 'success' | 'error' = 'success') {
    if (!alertPanel || !alertText) return;
    alertText.textContent = message;
    alertPanel.classList.remove('form-alert--success', 'form-alert--error');
    alertPanel.classList.add(tone === 'success' ? 'form-alert--success' : 'form-alert--error');
    alertPanel.hidden = false;
  }

  function hideAlert() {
    if (alertPanel) alertPanel.hidden = true;
  }

  alertClose?.addEventListener('click', hideAlert);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    hideAlert();
    if (formStatus) formStatus.textContent = '';

    if (!validateAll()) {
      if (formStatus) formStatus.textContent = 'Please fix the highlighted fields before submitting.';
      return;
    }

    submitBtn?.classList.add('is-loading');
    submitBtn?.setAttribute('disabled', 'true');

    const formData = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const result = await fakeServerSubmit(formData);

    submitBtn?.classList.remove('is-loading');
    submitBtn?.removeAttribute('disabled');

    if (result.ok) {
      if (formStatus) formStatus.textContent = 'Your message has been sent successfully.';
      showAlert('Thanks — your message has been sent. We\'ll be in touch soon.', 'success');
      form.reset();
      if (count) count.textContent = '0';
      fieldNames.forEach((name) => {
        fields[name]?.classList.remove('is-valid', 'is-invalid');
        const errorEl = document.getElementById(`${name}-error`);
        if (errorEl) errorEl.textContent = '';
      });
      alertPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      if (formStatus) formStatus.textContent = 'Something went wrong. Please try again.';
      showAlert('Something went wrong sending your message. Please try again.', 'error');
    }
  });
</script>

<style>
  .field-error {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: #d64545;
    min-height: 1.1em;
  }

  .field input.is-invalid,
  .field select.is-invalid,
  .field textarea.is-invalid {
    border-color: #d64545;
    box-shadow: 0 0 0 1px rgba(214, 69, 69, 0.25);
  }
  .field input.is-valid,
  .field select.is-valid,
  .field textarea.is-valid {
    border-color: #4a7c3c;
  }

  .message-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .message-meta-row .field-error {
    margin: 0;
    flex: 1;
    min-width: 0;
  }
  .message-meta-row .char-count {
    flex-shrink: 0;
    white-space: nowrap;
    color: #6b7280;
    font-size: 0.85rem;
    padding-top: 0.05rem;
  }

  /* Alert panel above the form */
  .form-alert {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }
  .form-alert--success {
    background: #eaf4e6;
    color: #345c28;
    border: 1px solid #bfe0b3;
  }
  .form-alert--error {
    background: #fbeaea;
    color: #7a2323;
    border: 1px solid #f0bcbc;
  }
  .form-alert span {
    flex: 1;
  }
  .form-alert button {
    background: none;
    border: none;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    color: inherit;
    opacity: 0.7;
  }
  .form-alert button:hover {
    opacity: 1;
  }

  .btn-primary {
    position: relative;
  }
  .btn-primary.is-loading .btn-label {
    visibility: hidden;
  }
  .btn-spinner {
    display: none;
  }
  .btn-primary.is-loading .btn-spinner {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>