---
import { COMPANY_NAME, COMPANY_SLOGAN } from '../lib/config';

import Layout from '../layouts/Layout.astro';
import BookCover from '../components/BookCover.astro';
import { books } from '../data/books.js';

const featured = books.find((b) => b.featured) ?? books[0];
---

<Layout title="About Us" active="about">
  <section class="page-banner">
    <div class="row wrap">
      <div class="col-12 col-lg-8">
        <p class="eyebrow">Our story</p>
        <h1>{COMPANY_NAME}</h1>
        <p>Emblem sells rare books direct via e-commerce and ships to any location. The collection is extensive and includes rare first editions and signed copies. All books are restored by expert craftsmen before sale, ensuring they arrive in excellent condition.</p>
        <p>Emblem specialises in 19th, 20th, and 18th century fiction and poetry. Occasionally, pre-18th century and non-fiction items are also available. All books can be independently valued on site before purchase — rare books can be a strong investment, with some appreciating by up to 15% in a single year and an average annual increase of 4.6%.</p>
        <p>Please <a href="/books/">browse our collection</a>. If something you are looking for is not currently available, feel free to <a href="/contact/">contact us</a>, and assistance will be provided.</p>
      </div>
        <aside class="col-lg-4 text-center d-none d-lg-block">
         <img
          src="/assets/images/main/authors.png"
          alt="Three classic authors: Oscar Wilde, Percy Shelly and Charlotte Bronte">
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="spotlight">
        <div class="wrap-inner">
          <div class="spotlight-cover">
            <div style="width:220px;">
              <BookCover title={featured.title} author={featured.author} color={featured.color} />
            </div>
          </div>
          <div>
            <p class="eyebrow" style="color:var(--gold-soft);">Book of the Month</p>
            <h2>{featured.title}</h2>
            <p>{featured.blurb}</p>
            <p class="stars">{'★'.repeat(featured.rating)}{'☆'.repeat(5 - featured.rating)}</p>
            <a class="btn btn-ghost-invert" href={`/books/${featured.slug}/`}>More info</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
