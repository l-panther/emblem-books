---
import Layout from '../layouts/Layout.astro';

const regions = [
  { id: 'uk', label: 'UK', open: true, rates: [
    { w: 'Up to 1kg', p: '£5.99' }, { w: 'Over 1kg', p: '£11.99' }, { w: 'Over 3kg', p: '£33.99' } ] },
  { id: 'europe', label: 'Europe', open: false, rates: [
    { w: 'Up to 1kg', p: '£9.99' }, { w: 'Over 1kg', p: '£18.99' }, { w: 'Over 3kg', p: '£44.99' } ] },
  { id: 'usa', label: 'USA / Canada', open: false, rates: [
    { w: 'Up to 1kg', p: '£14.99' }, { w: 'Over 1kg', p: '£26.99' }, { w: 'Over 3kg', p: '£59.99' } ] },
  { id: 'row', label: 'Rest of the World', open: false, rates: [
    { w: 'Up to 1kg', p: '£17.99' }, { w: 'Over 1kg', p: '£32.99' }, { w: 'Over 3kg', p: '£69.99' } ] },
];

const times = [
  { region: 'UK', days: '1 to 2 days' },
  { region: 'Europe', days: '2 to 3 days' },
  { region: 'USA/Canada', days: '3 to 5 days' },
  { region: 'Rest of the World', days: '5 to 14 days' },
];
---

<Layout 
  title="Delivery Information" 
  description="Find delivery information for Emblem Books, including shipping arrangements and useful guidance to help you understand how your book orders are delivered."
  active="delivery">
  <section class="page-banner">
    <div class="wrap">
      <p class="eyebrow">Shipping</p>
      <h1>Delivery</h1>
      <p>Deliveries are arranged using specialist couriers whenever appropriate, to ensure the safe transport of fragile and valuable books. All orders are dispatched via first-class delivery, both within the UK and internationally.</p>
      <p>Delivery is included in the purchase price for books valued at over <strong>£500</strong>. For books priced below this amount, the following delivery charges apply:</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap" style="max-width:900px;">
      <div id="accordion">
        {regions.map((region, i) => (
          <div class={`accordion-item ${region.open ? 'is-open' : ''}`} data-index={i}>
            <button class="accordion-trigger">
              <span>{region.label}</span>
              <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="accordion-panel">
              <div class="rate-grid">
                {region.rates.map((r) => (
                  <div><span>{r.w}</span><strong>{r.p}</strong></div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div style="margin-top:56px;">
        <h2 style="font-size:1.4rem;">Estimated delivery times</h2>
        <ul class="check-list">
          {times.map((t) => <li><strong>{t.region}</strong>&nbsp;— {t.days}</li>)}
        </ul>
        <p>However, delivery times may differ if repair to books is requested before dispatch.</p>
      </div>
    </div>
  </section>
</Layout>


<style>
/* ---------- accordion (delivery) ---------- */
.accordion-item {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  margin-bottom: 12px;
  overflow: hidden;
  background: var(--paper);
}
.accordion-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  background: var(--parchment-deep);
  border: none;
  font-family: var(--font-sans);
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  font-size: 13.5px;
  color: var(--ink);
  cursor: pointer;
}
.accordion-item.is-open .accordion-trigger {
  background: var(--forest);
  color: var(--paper);
}
.accordion-trigger .chev { transition: transform .2s ease; }
.accordion-item.is-open .accordion-trigger .chev { transform: rotate(180deg); }
.accordion-panel {
  display: none;
  padding: 30px 24px;
}
.accordion-item.is-open .accordion-panel { display: block; }
.rate-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  text-align: center;
}
.rate-grid div span { display: block; font-family: var(--font-sans); font-size: 13px; color: var(--ink-soft); margin-bottom: 6px; }
.rate-grid div strong { font-family: var(--font-display); font-size: 26px; color: var(--forest); }
</style>


<script>
  document.querySelectorAll('#accordion .accordion-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.closest('.accordion-item')?.classList.toggle('is-open');
    });
  });
</script>
