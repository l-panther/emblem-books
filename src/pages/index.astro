---
import { asset } from '../utils/paths';
import Layout from '../layouts/Layout.astro';
import BookCover from '../components/BookCover.astro';
import { books } from '../data/books.js';

const featured = books.find((b) => b.featured) ?? books[0];
---

<Layout 
  title="Emblem Books" 
  description="Discover Emblem Books, a destination for book lovers and collectors. Explore our collection, discover remarkable titles and learn about books as investments."
  active="home">

  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Est. in London · Rare &amp; collectible books</p>
        <h1>For classic, <em>fiction</em>&nbsp;and factual novels</h1>
        <p class="hero-sub">
          A hand-restored collection of first editions, signed copies and antiquarian finds —
          sourced, valued and shipped to collectors worldwide.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={asset('/books/')}>Browse the collection</a>
          <a class="btn btn-ghost" href={asset('/contact')}>Talk to us</a>
        </div>
        <div class="hero-stats">
          <div><strong>1780s</strong><span>Earliest editions</span></div>
          <div><strong>4.6%</strong><span>Avg. annual appreciation</span></div>
        </div>
      </div>

      <div class="hero-shelf">
          <img class="text-center"
            src={asset('assets/images/hero/books2.png')}
            alt="Uylsses by James Joyce by Rumour of the night by Graham Green"/>
      </div>
    </div>
  </section>

  <section class="feature-strip">
    <div class="wrap feature-grid">
      <div class="feature">
        <div class="feature-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 9h16M9 4v16"/></svg>
        </div>
        <div>
          <h3>Scheduled Print</h3>
          <p>We issue printed and illustrated catalogues of rare books twice a year.</p>
        </div>
      </div>
      <div class="feature">
        <div class="feature-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.4 3.8 5.4 3.8 8.5s-1.3 6.1-3.8 8.5c-2.5-2.4-3.8-5.4-3.8-8.5S9.5 5.9 12 3.5Z"/></svg>
        </div>
        <div>
          <h3>International Service</h3>
          <p>We exhibit at book fairs in the UK, New Zealand, Canada and USA.</p>
        </div>
      </div>
      <div class="feature">
        <div class="feature-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12a8 8 0 1 0 2.6-5.9"/><path d="M4 4v5h5M12 8v4l3 2"/></svg>
        </div>
        <div>
          <h3>Book Restoration</h3>
          <p>We also provide a specialist book restoration and rebinding service.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="spotlight">
        <div class="wrap-inner">
          <div class="spotlight-cover">
            <div style="width:220px;">
              <BookCover title={featured.title} author={featured.author} color={featured.color} />
            </div>
          </div>
          <div>
            <p class="eyebrow" style="color:var(--gold-soft);">Book of the Month</p>
            <h2>{featured.title}</h2>
            <p>{featured.blurb}</p>
            <p class="stars">{'★'.repeat(featured.rating)}{'☆'.repeat(5 - featured.rating)}</p>
            <a
              class="btn btn-ghost-invert"
              href={`${import.meta.env.BASE_URL}books/${featured.slug}/`}
            >
              More info
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="section-head left">
        <p class="eyebrow">How it works</p>
        <h2>Selling, valuing &amp; buying</h2>
      </div>
      <div class="process">
        <div class="process-step">
          <span class="num">01 — Sell</span>
          <h3>Selling books</h3>
          <p>We are particularly interested in 18th and 19th century books, and hold a world-renowned stock of later 19th-century women's writing.</p>
        </div>
        <div class="process-step">
          <span class="num">02 — Value</span>
          <h3>Valuing books</h3>
          <p>A free initial verbal assessment is recommended. Written valuations are charged at a half-day rate of £300.</p>
        </div>
        <div class="process-step">
          <span class="num">03 — Buy</span>
          <h3>Buying rare books</h3>
          <p><a href="/contact/">Contact us</a> with the author, title, edition and condition — we'll come back with a competitive offer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--parchment-deep); padding-top:80px;">
    <div class="row wrap">
      <div class="col-12 col-lg-6 p-0">
        <p class="eyebrow">Watch</p>
        <h2>The journey starts here</h2>
        <p>From first sighting to final restoration, every book in the collection is authenticated, repaired by hand, and catalogued before it reaches a shelf.</p>
        <a class="btn btn-primary" href={asset('/about')}>More about Emblem</a>
      </div>

      <div class="col-12 col-lg-6 text-center">
        <video class="rounded-4" controls aria-describedby="video-description" poster="assets/images/main/poster.png">
          <source src="assets/media/emblem_video.webm" type="video/webm">
          <source src="assets/media/emblem_video_480x360.ogg" type="video/ogg">
          <source src="assets/media/emblem_video_480x360.mp4" type="video/mp4">

          <p>
            Your browser does not support embedded video.
            You can
            <a href="assets/media/emblem_video_480x360.mp4">download the video file</a>
            instead.
          </p>
        </video>

        <p id="video-description" class="visually-hidden">
          This video demonstrates the warehouse handling and restoration process used by Emblem Books in Miles End.
        </p>
      </div>
    </div>
    <p style="color:rgba(247,242,230,.85); font-size:13px; letter-spacing:.06em; text-transform:uppercase; margin:0;">Let's Read Together</p>
  </section>
</Layout>


<style>
  /* ---------- hero ---------- */
.hero {
  padding: 76px 0 40px;
  overflow: hidden;
}
.hero .wrap {
  display: grid;
  grid-template-columns: 1.05fr 0.85fr;
  gap: 56px;
  align-items: center;
}
.hero h1 em {
  font-style: italic;
  color: var(--forest);
}
.hero-sub {
  font-family: var(--font-sans);
  font-size: 17px;
  color: var(--ink-soft);
  max-width: 46ch;
  margin-bottom: 30px;
}
.hero-ctas {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 40px;
}
.hero-stats {
  display: flex;
  gap: 34px;
  font-family: var(--font-sans);
  flex-wrap: wrap;
}
.hero-stats strong {
  display: block;
  font-family: var(--font-display);
  font-size: 22px;
  color: var(--forest);
}
.hero-stats span {
  font-size: 12px;
  color: var(--ink-soft);
  text-transform: uppercase;
  letter-spacing: .06em;
}

.hero img {
  margin: auto;
  width: 60%;
}
/* Mobile / tablet — centred */
.hero .wrap {
  align-items: center;
  text-align: center;
}

.hero-content {
  max-width: 640px;
}

.hero-sub {
  margin-left: auto;
  margin-right: auto;
}

.hero-ctas,
.hero-stats {
  justify-content: center;
}

.spine-stack {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10px;
  height: 320px;
  padding: 0 6px;
}
.spine {
  border-radius: 3px 3px 0 0;
  position: relative;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.08), 0 10px 24px -12px rgba(24,39,32,0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 14px;
}
.spine span {
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  font-family: var(--font-display);
  color: rgba(255,255,255,0.92);
  font-size: 13px;
  letter-spacing: .04em;
  white-space: nowrap;
}
.spine::before {
  content: "";
  position: absolute;
  top: 10px; bottom: 10px; left: 6px; right: 6px;
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 2px;
}

.emblem-badge {
  position: absolute;
  right: 80px;
  top: 180px;
  width: 92px;
  height: 92px;
  background: var(--paper);
  border-radius: 50%;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1px solid var(--line);
  font-family: var(--font-sans);
  text-align: center;
}
.emblem-badge strong {
  font-family: var(--font-display);
  color: var(--forest);
  font-size: 20px;
  line-height: 1;
}
.emblem-badge span {
  font-size: 9px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin-top: 2px;
}

/* ---------- feature strip ---------- */
.feature-strip {
  background: var(--forest);
  background-image: radial-gradient(120% 180% at 10% -20%, rgba(255,255,255,0.06), transparent 60%);
  color: var(--paper);
  padding: 56px 0;
}
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}
.feature {
  display: flex;
  gap: 16px;
}
.feature-icon {
  width: 46px;
  height: 46px;
  flex: none;
  border-radius: 50%;
  border: 1px solid rgba(247,242,230,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.feature h3 {
  color: var(--paper);
  font-size: 16px;
  margin-bottom: 6px;
}
.feature p {
  color: rgba(247,242,230,0.78);
  font-size: 14.5px;
  margin: 0;
}

/* Video */
video { width:80%; margin-top: 4rem;}

/* ---------- responsive ---------- */
/* Desktop — left aligned */
@media (min-width: 993px) {
  video { width:80%; margin-top: 0rem;}
}

@media (min-width: 981px) {
  .hero .wrap {
    align-items: flex-start;
    text-align: left;
  }
  .hero img { width: 100%;}

  .hero-sub {
    margin-left: 0;
    margin-right: 0;
  }
  .hero-ctas,
  .hero-stats {
    justify-content: flex-start;
  }
}

@media (max-width: 980px) {
  .hero .wrap { grid-template-columns: 1fr; align-items: center !important;}
  .hero-shelf { order: -1; }
  
  .feature-grid { grid-template-columns: 1fr; gap: 28px; }
  .spotlight .wrap-inner { grid-template-columns: 1fr; padding: 44px 28px; }
}
</style>
